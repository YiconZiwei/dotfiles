# ── Autojump ──
[ -f /opt/homebrew/etc/profile.d/autojump.sh ] && . /opt/homebrew/etc/profile.d/autojump.sh

# ── Shell Optimizations for Claude Code (S117 D2) ──
setopt no_nomatch              # Don't error on unmatched globs (Claude uses * often)
setopt interactive_comments    # Allow # comments in interactive shell
setopt extended_history        # Add timestamps to history entries

# ── iTerm2 Shell Integration (command markers · output capture · badges) ──
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# ── iTerm2 Badge: show 🤖 when Claude Code is active ──
if [ "$ITERM_SESSION_ID" ]; then
  function iterm2_print_user_vars() {
    if [[ -n "$CLAUDE_SESSION_ID" ]]; then
      iterm2_set_user_var claude_active "🤖"
    else
      iterm2_set_user_var claude_active ""
    fi
  }
  # Tab title shows current directory name
  precmd() {
    echo -ne "\033]0;${PWD##*/}\007"
  }
fi
