{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(cargo *)",
      "Bash(ruff *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(brew *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(*secret*)",
      "Read(*credential*)",
      "Bash(rm -rf /)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(chmod 777 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/yc/Ziwei/hooks/iron-law-check.py"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/yc/Ziwei/hooks/mission-state-update.py"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/yc/Ziwei/hooks/distillation-capture.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "cli-anything@HKUDS-CLI-Anything": true,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "oh-my-claudecode@omc": false,
    "pua@pua-skills": false,
    "andrej-karpathy-skills@karpathy-skills": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "ecc@ecc": false
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "omc": {
      "source": {
        "source": "directory",
        "path": "/Users/yc/oh-my-claudecode"
      }
    },
    "pua-skills": {
      "source": {
        "source": "directory",
        "path": "/Users/yc/pua"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "directory",
        "path": "/Users/yc/andrej-karpathy-skills"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "directory",
        "path": "/Users/yc/ui-ux-pro-max-skill"
      }
    },
    "ecc": {
      "source": {
        "source": "directory",
        "path": "/Users/yc/everything-claude-code"
      }
    }
  },
  "effortLevel": "high",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "verbose": false
}